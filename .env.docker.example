# Copy this file to .env and fill in the values, then run: docker compose up -d

# AI Provider (Deepseek - OpenAI compatible)
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Cron secret for protecting cron API routes
CRON_SECRET=change-me-in-production

# Admin login password
ADMIN_PASSWORD=admin123

# Public URL (used for sitemap/rss absolute URLs)
NEXT_PUBLIC_URL=http://localhost:3000
